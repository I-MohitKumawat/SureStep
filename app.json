{
  "expo": {
    "name": "SureStep",
    "slug": "surestep",
    "scheme": "surestep",
    "version": "1.0.0",
    "sdkVersion": "54.0.0",
    "orientation": "portrait",
    "platforms": [
      "ios",
      "android"
    ],
    "jsEngine": "hermes",
    "plugins": [
      "@react-native-community/datetimepicker",
      "expo-font",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "SureStep monitors your patient's location continuously to alert you if they leave their safe zone.",
          "locationAlwaysPermission": "SureStep needs background location access to monitor patient safety even when the app is closed.",
          "locationWhenInUsePermission": "SureStep needs location access to show the patient's position on the map.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-task-manager"
      ],
      "expo-secure-store",
      "expo-web-browser",
      "@react-native-firebase/app",
      "@react-native-firebase/auth"
    ],
    "android": {
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ],
      "googleServicesFile": "./google-services.json",
      "package": "com.anonymous.surestep"
    },
    "ios": {
      "infoPlist": {
        "NSLocationAlwaysAndWhenInUseUsageDescription": "SureStep monitors your patient's location continuously to alert you if they leave their safe zone.",
        "NSLocationAlwaysUsageDescription": "SureStep needs background location access to monitor patient safety even when the app is closed.",
        "NSLocationWhenInUseUsageDescription": "SureStep needs location access to show the patient's position on the map.",
        "UIBackgroundModes": [
          "location",
          "fetch"
        ]
      }
    }
  }
}
