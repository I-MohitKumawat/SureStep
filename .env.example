# =============================================================================
# SureStep Frontend — Environment Variables Example
# =============================================================================
# Copy this file to .env and fill in the real values.
# All environment variables in Expo must be prefixed with EXPO_PUBLIC_ 
# to be exposed to the client-side code.

# ─── Express API Server ──────────────────────────────────────────────────────
# The URL of your running Express backend.
# In development, use your machine's local IP (e.g. http://192.168.1.50:3000) 
# instead of localhost when testing on a physical iOS/Android device.
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1

# ─── Firebase Client configuration (Required for Firebase Auth initialization) ──
# Even if you only use Firebase for authentication, the Firebase Client SDK 
# requires this full config block to initialize the Firebase app instance on the mobile client.
# Find these keys in: Firebase Console → Project Settings → General → Your Apps → Web App / Web config
EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSyA1...
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE
EXPO_PUBLIC_DISABLE_NATIVE_MAPS=false
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=sure-step.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=sure-step
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=sure-step.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
EXPO_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef123456

